<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkService.Views"
             xmlns:fa5 ="http://schemas.fontawesome.com/icons/"
             xmlns:model="clr-namespace:NetworkService.Model"
             xmlns:converter="clr-namespace:NetworkService.Helpers.Converters"
             xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
             mc:Ignorable="d" 
             Focusable="True"
             d:DesignHeight="550" d:DesignWidth="1000">
    <UserControl.DataContext>
        <viewModel:NetworkDisplayViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <converter:ReadingToGraphPositionConverter x:Key="GraphConverter" />
        <converter:DisplayErrorColorConverter x:Key="DisplayErrorConverter" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding UndoAllCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TreeView 
            x:Name="TreeView"
            Grid.Column="0"
            Margin="10"
            ItemsSource="{Binding EntitiesByType}"
            MouseLeftButtonUp="TreeView_MouseLeftButtonUp"
            SelectedItemChanged="TreeView_SelectedItemChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            AllowDrop="True"
            Drop="TreeView_Drop"
            DragOver="TreeView_DragOver">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type model:EntityByType}"
                                  ItemsSource="{Binding Entities}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                           FontSize="13"
                           Text="{Binding Type.Name}"
                           VerticalAlignment="Center"/>
                        <TextBlock Margin="6,0,0,0"
                           FontSize="11"
                           Foreground="Gray"
                           VerticalAlignment="Center">
                            <TextBlock.Text>
                                <Binding Path="Entities.Count" StringFormat="({0})"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type model:Entity}">
                    <StackPanel 
                            Orientation="Horizontal" 
                            Margin="0,2,0,2">
                        <TextBlock 
                            Text="{Binding ID, StringFormat='#{0}'}"
                            Width="36"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="Gray"
                            VerticalAlignment="Center"/>
                        <TextBlock 
                            Text="{Binding Name}"
                            Width="140"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
        <Canvas
            Grid.Column="1"
            Margin="5 15 5 5">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Canvas
                                AllowDrop="True"
                                Width="150"
                                Height="120"
                                Tag="{Binding}"
                                DragOver="Canvas_DragOver"
                                Drop="Canvas_Drop"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseRightButtonDown="Canvas_MouseRightButtonDown">
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTaken}" Value="True">
                                                <Setter Property="Background" Value="{Binding Background}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>
                                <StackPanel Orientation="Vertical"
                                            Canvas.Bottom="5"
                                            Canvas.Right="10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTaken}" Value="False" >
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Entity.ID, StringFormat='{}#{0} '}" 
                                               Foreground="{StaticResource TertirayColor}" 
                                               FontWeight="DemiBold" />
                                    <TextBlock Text="{Binding Entity.Name}" 
                                               Foreground="{StaticResource SecondaryColor}"/>

                                    <TextBlock Text="{Binding Entity.Value, StringFormat={}[{0} °C]}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                <Setter Property="FontWeight" Value="ExtraBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Entity.Value, Converter={StaticResource DisplayErrorConverter}}" Value="false">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                </StackPanel>
                                <TextBlock Text="Drop Here"
                                           Canvas.Top="52"
                                           Canvas.Left="50">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TertirayColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTaken}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Rectangle
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Stroke="Crimson"
                                        StrokeThickness="3"
                                        IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Entity.Value, Converter={StaticResource DisplayErrorConverter}}" Value="false">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                    Stroke="Cyan"
                                    StrokeThickness="3"
                                    IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Canvas>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Path=Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line 
                            Stroke="{StaticResource SecondaryHighlightColor}" 
                            StrokeThickness="4"
                            Opacity="0.3"
                            X1="{Binding Path=Item1.X, Converter={StaticResource GraphConverter}, ConverterParameter=75}"
                            X2="{Binding Path=Item2.X, Converter={StaticResource GraphConverter}, ConverterParameter=75}"
                            Y1="{Binding Path=Item1.Y, Converter={StaticResource GraphConverter}, ConverterParameter=60}"
                            Y2="{Binding Path=Item2.Y, Converter={StaticResource GraphConverter}, ConverterParameter=60}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
        <StackPanel
         Margin="10 10 10 10"
         Grid.Column="4"
         Grid.Row="2"
         Grid.RowSpan="3">
            <TextBlock
                 Height="20"
                 Style="{StaticResource HistoryHeader}"
                 Text="History"
                 ToolTip="All previous actions on this page are shown here"/>
            <ListView
             Height="260"
             ItemsSource="{Binding History.History}">
            </ListView>
        </StackPanel>
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Vertical"
            Margin="5,5,5,2">

            <Button
                Width="80"
                Height="20"
                Margin="0,0,4,0"
                Command="{Binding UndoCommand}"
                ToolTip="Undo last action (Ctrl+Z)">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Height="13" Foreground="Gray" Icon="Solid_UndoAlt" />
                    <TextBlock Margin="5,0,0,0" Text="Undo" />
                </StackPanel>
            </Button>
            <Button
                Width="80"
                Height="20"
                Margin="0,0,4,0"
                Command="{Binding UndoAllCommand}"
                ToolTip="Undo All actions (Ctrl+Shift+Z)">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Height="13" Foreground="Gray" Icon="Solid_Backward" />
                    <TextBlock Margin="5,0,0,0" Text="Undo All" />
                </StackPanel>
            </Button>
            <Button
                Width="80"
                Height="20"
                Margin="0,0,4,0"
                Command="{Binding RedoCommand}"
                ToolTip="Undo last action (Ctrl+Y)">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Height="13" Foreground="Gray" Icon="Solid_RedoAlt" />
                    <TextBlock Margin="5,0,0,0" Text="Redo" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
