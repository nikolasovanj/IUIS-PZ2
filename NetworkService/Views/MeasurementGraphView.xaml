<UserControl x:Class="NetworkService.Views.MeasurementGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkService.Views"
             xmlns:converter="clr-namespace:NetworkService.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:ReadingToGraphPositionConverter x:Key="GraphConverter"/>
        <converter:ReadingToGraphTimeConverter x:Key="TimeConverter" />
        <converter:TypeCountToGraphWidthConverter x:Key="TypeCountConverter" />
        <converter:GraphPointColorConverter x:Key="ColorConverter" />
        <converter:GraphVisibilityConverter x:Key="VisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ComboBox 
            Grid.Row="1"
            Grid.Column="1"
            Width="160"
            Height="30"
            ItemsSource="{Binding Entities}"
            SelectedItem="{Binding CurrentEntity, Mode=TwoWay}"
            DisplayMemberPath="Name"/>
        <StackPanel
            Grid.Column="2"
            Grid.Row="1"
            Orientation="Horizontal"
            Visibility="{Binding CurrentEntity.LastValues, Converter={StaticResource VisibilityConverter}, ConverterParameter=true}">
            <StackPanel 
                Orientation="Horizontal"
                Height="40">
                <Rectangle
                    Height="10"
                    Width="10"
                    Fill="DodgerBlue"/>
                <TextBlock
                    Margin="2"
                    VerticalAlignment="Center"
                    Text="Valid"/>
            </StackPanel>
            <StackPanel 
                Margin="10 0 0 0 "
                Orientation="Horizontal"
                Height="40">        
                <Rectangle
                    Height="10"
                    Width="10"
                    Fill="Crimson"/>
                <TextBlock
                    Margin="2"
                    VerticalAlignment="Center"
                    Text="Out of bounds"/>
            </StackPanel>
        </StackPanel>
        <Canvas
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding Path=Edges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line 
                            Stroke="Black" 
                            StrokeThickness="4"
                            X1="{Binding Path=Point1.X, Converter={StaticResource GraphConverter}, ConverterParameter=20}"
                            X2="{Binding Path=Point2.X, Converter={StaticResource GraphConverter}, ConverterParameter=20}"
                            Y1="{Binding Path=Point1.Y, Converter={StaticResource GraphConverter}, ConverterParameter=20}"
                            Y2="{Binding Path=Point2.Y, Converter={StaticResource GraphConverter}, ConverterParameter=20}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Path=Points}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Canvas.Left" Value="{Binding Path=X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Path=Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Width="40" Height="40">
                            <Ellipse 
                                 Fill="{Binding Value, Converter={StaticResource ColorConverter}}"
                                 Stroke="Black"
                                 StrokeThickness="2"/>
                            <TextBlock 
                                Text="{Binding Path=Value}" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Line 
                X1="0"
                Y1="300"
                X2="480"
                Y2="300"
                Stroke="Black"
                StrokeThickness="2"/>
            <ItemsControl ItemsSource="{Binding Points}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="310" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock 
                            Text="{Binding Time, Converter={StaticResource TimeConverter}}"
                            Width="50"
                            TextAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Grid
                Visibility="{Binding CurrentEntity.LastValues, Converter={StaticResource VisibilityConverter}}">
                <Rectangle
                Height="400"
                Width="480"
                Fill="White"/>
                <TextBlock 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="30"
                    Text="Not enough data yet..."/>
            </Grid>
        </Canvas>
        
        <Grid
            Grid.Row="2"
            Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Canvas
                x:Name="RatioCanvas"
                Grid.Row="1">
                <Rectangle
                    Width="240"
                    Height="72"
                    HorizontalAlignment="Right"
                    Fill="Goldenrod"/>
                <Rectangle
                    Width="{Binding TypeCount, Converter={StaticResource TypeCountConverter}}"
                    Height="72"
                    HorizontalAlignment="Left"
                    Fill="CadetBlue"/>
            </Canvas>
            
            <StackPanel
                Grid.Row="2">
                <StackPanel
                    Height="20">
                    <Canvas>
                        <TextBlock Text="0%"
                                   Canvas.Left="-10"/>
                        <TextBlock Text="20%"
                                   Canvas.Left="38"/>
                        <TextBlock Text="40%"
                                   Canvas.Left="86"/>
                        <TextBlock Text="60%"
                                   Canvas.Left="132"/>
                        <TextBlock Text="80%"
                                   Canvas.Left="180"/>
                        <TextBlock Text="100%"
                                   Canvas.Left="228"/>
                    </Canvas>
                </StackPanel>
                <StackPanel 
                    Orientation="Horizontal"
                    Height="40">
                    <Rectangle
                        Height="10"
                        Width="10"
                        Fill="CadetBlue"/>
                    <TextBlock
                        Margin="2"
                        VerticalAlignment="Center"
                        Text="RTD"/>
                </StackPanel>
                <StackPanel 
                    Orientation="Horizontal"
                    Height="40">
                    <Rectangle
                        Height="10"
                        Width="10"
                        Fill="Goldenrod"/>
                    <TextBlock
                        Margin="2"
                        VerticalAlignment="Center"
                        Text="TC"/> 
                </StackPanel>
            </StackPanel>
        </Grid>
        


    </Grid>
</UserControl>
